# Inputs: deployment environment variables supplied by the operator; no secrets are stored in this file.
# Outputs: documented variable names and safe defaults consumed by config.py.
# Explanation: Example configuration for the FastAPI API, D1, Meta Muse, Resend, Cal.com, and optional Apollo integrations.

# Cloudflare D1 REST API
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_DATABASE_ID=
CLOUDFLARE_API_TOKEN=

# Meta Muse Ember 1.0 (API token uses Bearer authentication)
API_TOKEN=
MUSE_API_BASE_URL=https://api.meta.ai/v1
MUSE_MODEL=muse-ember-1.0

# Authentication and first-admin seed
JWT_SECRET=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Resend is required for auth codes and outbound mail
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_WEBHOOK_SECRET=
PUBLIC_APP_URL=

# Apollo is optional and disabled until explicitly enabled
APOLLO_ENABLED=false
APOLLO_API_KEY=
APOLLO_RATE_LIMIT_RPM=50

# Cal.com API v2
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=
CALCOM_API_BASE_URL=https://api.cal.com/v2
CALCOM_WEBHOOK_SECRET=
CALCOM_PUBLIC_BOOKING_URL=

# Runtime
APP_ENV=production
CORS_ORIGINS=
